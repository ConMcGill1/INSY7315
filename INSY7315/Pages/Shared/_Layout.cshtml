@{
    var site = "Inventory";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@site</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-page="/Index">@site</a>
            <div class="navbar-nav me-auto">
                <a class="nav-link" asp-page="/Index">Products</a>
                <a class="nav-link" asp-page="/Create">Create</a>
                <a class="nav-link" asp-page="/Dashboard">Dashboard</a>
                <a class="nav-link" asp-page="/Alerts">Alerts</a>
                <a class="nav-link" asp-page="/Export">Exports</a>
            </div>
            <div class="navbar-nav ms-auto">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
    <main class="container pb-5">
        @RenderBody()
    </main>
    @RenderSection("Scripts", required: false)
</body>
</html>
